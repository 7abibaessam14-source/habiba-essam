# Copy this file to  .streamlit/secrets.toml  and put your real values.
# NEVER upload secrets.toml to GitHub.

[snowflake]
account = "YOUR_ACCOUNT"
user = "YOUR_USER"
password = "YOUR_PASSWORD"
warehouse = "YOUR_WAREHOUSE"
database = "YOUR_DATABASE"
schema = "PUBLIC"

[airflow]
base_url = "http://localhost:8080"
dag_id = "power_consumption_pipeline"
user = "airflow"
password = "airflow"

# Optional: only if you want the "Email these alerts" button
# [smtp]
# host = "smtp.gmail.com"
# port = 587
# user = "you@gmail.com"
# password = "APP_PASSWORD"
# to = ["you@gmail.com"]

# Optional: "Sign in with Google". Anyone with a Google account can sign in as a viewer;
# the emails in [roles] admin_emails sign in as admin. Values come from Google Cloud Console.
# cookie_secret: any long random text, e.g. from  py -c "import secrets; print(secrets.token_urlsafe(32))"
# [auth]
# redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# cookie_secret = "PASTE_LONG_RANDOM_TEXT"
#
# [auth.google]
# client_id = "PASTE.apps.googleusercontent.com"
# client_secret = "PASTE_CLIENT_SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# [roles]
# admin_emails = ["you@gmail.com"]

# Optional: login page. Without any [auth.users.*] section the app opens without a login.
# Make the lines for each user with:  py make_password_hash.py   (it never prints the password)
# role = "admin"  -> every page          role = "viewer" -> no Pipeline monitor, no email button
# [auth.users.admin]
# password_hash = "pbkdf2_sha256$200000$PASTE_SALT$PASTE_HASH"
# role = "admin"
#
# [auth.users.guest]
# password_hash = "pbkdf2_sha256$200000$PASTE_SALT$PASTE_HASH"
# role = "viewer"
